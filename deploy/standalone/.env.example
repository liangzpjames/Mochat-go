# MoChat Go standalone release candidate environment.
# Copy to deploy/standalone/.env.local and replace every value marked with CHANGE_ME.

MOCHAT_GO_PORT=18080
MOCHAT_SIDEBAR_PORT=18081
MOCHAT_OPERATION_PORT=18082
MOCHAT_MYSQL_PORT=13316
MOCHAT_REDIS_PORT=26389

# 应用、MariaDB 和日报窗口必须使用同一 IANA 时区。
MOCHAT_GO_RUNTIME_ROLE=all
MOCHAT_TIMEZONE=Asia/Shanghai

MOCHAT_MYSQL_DATABASE=mochat
MOCHAT_MYSQL_USER=mochat
MOCHAT_MYSQL_PASSWORD=CHANGE_ME_mysql_password
MOCHAT_MYSQL_ROOT_PASSWORD=CHANGE_ME_mysql_root_password

MOCHAT_SIMPLE_JWT_SECRET=CHANGE_ME_dashboard_jwt_secret_at_least_32_chars
MOCHAT_SIMPLE_JWT_PREFIX=mc_jwt_
# SaaS 与 Dashboard 使用不同的签名密钥、签发方、受众和 token 前缀；这里仅保留占位符。
MOCHAT_SAAS_ADMIN_JWT_SECRET=CHANGE_ME_saas_admin_jwt_secret_at_least_32_chars
MOCHAT_SAAS_ADMIN_JWT_ISSUER=mochat-go/saas-auth
MOCHAT_SAAS_ADMIN_JWT_AUDIENCE=mochat-saas-admin
MOCHAT_SAAS_ADMIN_JWT_PREFIX=mochat_saas_admin_
MOCHAT_SAAS_ADMIN_JWT_TTL=604800
# SaaS MFA 密钥只允许通过宿主机受限 secret 文件提供；不要把密钥内容写入环境变量、命令行或仓库。
MOCHAT_SAAS_ADMIN_MFA_ENCRYPTION_KEY_FILE=/secure/path/from-secret-manager/mochat-saas-admin-mfa-encryption-key
MOCHAT_SAAS_ADMIN_MFA_ENCRYPTION_KEY_ID=saas-mfa-primary
MOCHAT_SAAS_ADMIN_MFA_REQUIRED=0
MOCHAT_DASHBOARD_JWT_SECRET=CHANGE_ME_dashboard_jwt_secret_at_least_32_chars
MOCHAT_DASHBOARD_JWT_ISSUER=mochat-go/dashboard-auth
MOCHAT_DASHBOARD_JWT_AUDIENCE=mochat-dashboard
MOCHAT_DASHBOARD_JWT_PREFIX=mochat_dashboard_
MOCHAT_DASHBOARD_JWT_TTL=604800
# Dashboard MFA 密钥必须使用与 SaaS MFA 不同的受限 secret 文件；不要把密钥内容写入环境变量、命令行或仓库。
MOCHAT_DASHBOARD_MFA_ENCRYPTION_KEY_FILE=/secure/path/from-secret-manager/mochat-dashboard-mfa-encryption-key
MOCHAT_DASHBOARD_MFA_ENCRYPTION_KEY_ID=dashboard-mfa-primary
MOCHAT_DASHBOARD_MFA_REQUIRED=0
MOCHAT_SIDEBAR_JWT_SECRET=CHANGE_ME_sidebar_jwt_secret_at_least_32_chars
MOCHAT_SIDEBAR_JWT_PREFIX=default

# SaaS 总后台；平台租户超级管理员可管理全局，普通租户只能访问授权的本租户能力。
MOCHAT_GO_ENABLE_SAAS_ADMIN_DASHBOARD=0
# 获客前默认单人运营，确保唯一平台管理员可以创建首个客户；增加第二位平台管理员后改为 1 启用双人审批。
MOCHAT_GO_SAAS_ADMIN_APPROVAL_REQUIRED=0
MOCHAT_GO_ENABLE_SAAS_BILLING_PORTAL=0
MOCHAT_GO_SAAS_PLATFORM_ADMIN_TENANT_ID=1
# 官方镜像会在构建时内置源码/验收指纹。仅本地直接 go run 时可填写当前 scripts/source_fingerprint.py 输出；镜像内置值优先，不能被环境变量覆盖。
MOCHAT_GO_RELEASE_SOURCE_FINGERPRINT=
# 发布证据标记通过时下载工件校验，创建候选时再次下载复核。默认 30 秒、最大 64 MiB。
MOCHAT_GO_SAAS_RELEASE_EVIDENCE_VERIFY_TIMEOUT_SECONDS=30
MOCHAT_GO_SAAS_RELEASE_EVIDENCE_MAX_BYTES=67108864
# 默认阻断私网；内部 HTTPS 证据库必须显式填写最小 CIDR。自有 CA 文件路径必须是 app 容器内可读路径。
MOCHAT_GO_SAAS_RELEASE_EVIDENCE_ALLOWED_CIDRS=
MOCHAT_GO_SAAS_RELEASE_EVIDENCE_CA_FILE=

# 服务账号 API Key 使用独立 32 字节 pepper，不再与 Dashboard JWT 密钥共享生命周期。
MOCHAT_GO_SAAS_SERVICE_ACCOUNT_KEY_PEPPER=CHANGE_ME_64_hex_or_base64_bytes
# JSON 对象保留当前及历史 pepper；当前 ID 必须存在。
MOCHAT_GO_SAAS_SERVICE_ACCOUNT_KEY_PEPPERS=
MOCHAT_GO_SAAS_SERVICE_ACCOUNT_KEY_PEPPER_ID=primary
# 升级期保留旧 JWT pepper，所有生效旧 Key 轮换后再设为 0。
MOCHAT_GO_SAAS_SERVICE_ACCOUNT_ALLOW_LEGACY_JWT_PEPPER=1
MOCHAT_GO_SAAS_SERVICE_ACCOUNT_REQUIRE_DEDICATED_PEPPER=1

# 反向代理后才需开启。开启任一代理头开关时必须显式列出可信的代理 IP/CIDR；直连请求伪造的转发头会被忽略。
MOCHAT_GO_SAAS_TRUSTED_PROXY_CIDRS=
MOCHAT_GO_SAAS_IDENTITY_TRUST_PROXY_HEADERS=0
MOCHAT_GO_SAAS_SERVICE_ACCOUNT_TRUST_PROXY_HEADERS=0

# 告警 Webhook 默认只允许 HTTPS 公网地址，并在 DNS 解析、实际连接和同源重定向阶段持续复核。
# 内网接收端必须按最小 CIDR 显式放行；云元数据地址即使命中例外也会被阻断。
MOCHAT_GO_ENABLE_SAAS_ALERT_DASHBOARD=0
MOCHAT_GO_SAAS_ALERT_WEBHOOK_URL=
MOCHAT_GO_SAAS_ALERT_WEBHOOK_SECRET=
MOCHAT_GO_SAAS_ALERT_WEBHOOK_REQUIRE_HTTPS=1
MOCHAT_GO_SAAS_ALERT_WEBHOOK_ALLOWED_CIDRS=
# 生产应使用独立 32 字节密钥环；升级时保留历史密钥，完成轮换后再删除旧密钥。
MOCHAT_GO_SAAS_ALERT_CREDENTIAL_ENCRYPTION_KEY=
MOCHAT_GO_SAAS_ALERT_CREDENTIAL_ENCRYPTION_KEYS=
MOCHAT_GO_SAAS_ALERT_CREDENTIAL_ENCRYPTION_KEY_ID=primary
MOCHAT_GO_SAAS_ALERT_CREDENTIAL_REQUIRE_ENCRYPTION=0
# 企业微信企业与应用凭据应使用独立 32 字节密钥环；完成存量轮换后再开启强制加密。
MOCHAT_GO_WECOM_CREDENTIAL_ENCRYPTION_KEY=
MOCHAT_GO_WECOM_CREDENTIAL_ENCRYPTION_KEYS=
MOCHAT_GO_WECOM_CREDENTIAL_ENCRYPTION_KEY_ID=primary
MOCHAT_GO_WECOM_CREDENTIAL_REQUIRE_ENCRYPTION=0
MOCHAT_GO_WECOM_CREDENTIAL_ROTATION_LIMIT=100
# 微信开放平台 Ticket、组件密钥和公众号授权凭据应使用独立密钥环；未配置时依次复用企微、身份、合规或备份密钥材料并使用独立派生域。
MOCHAT_GO_WECHAT_OPEN_CREDENTIAL_ENCRYPTION_KEY=
MOCHAT_GO_WECHAT_OPEN_CREDENTIAL_ENCRYPTION_KEYS=
MOCHAT_GO_WECHAT_OPEN_CREDENTIAL_ENCRYPTION_KEY_ID=primary
MOCHAT_GO_WECHAT_OPEN_CREDENTIAL_REQUIRE_ENCRYPTION=0
MOCHAT_GO_WECHAT_OPEN_CREDENTIAL_ROTATION_LIMIT=100
MOCHAT_GO_SAAS_ALERT_WEBHOOK_TIMEOUT_SECONDS=5
MOCHAT_GO_SAAS_ALERT_WEBHOOK_RETRY_ATTEMPTS=1
MOCHAT_GO_SAAS_ALERT_WEBHOOK_RETRY_DELAY_MS=250
MOCHAT_GO_SAAS_ALERT_NOTIFICATION_MAX_ATTEMPTS=3
MOCHAT_GO_SAAS_ALERT_NOTIFICATION_RETRY_DELAY_SECONDS=300
MOCHAT_GO_ENABLE_SAAS_ALERT_NOTIFICATION_DISPATCH_CRON=0
MOCHAT_GO_SAAS_ALERT_NOTIFICATION_DISPATCH_CRON_INTERVAL_SECONDS=300
MOCHAT_GO_SAAS_ALERT_NOTIFICATION_DISPATCH_CRON_RUN_ON_START=0
MOCHAT_GO_SAAS_ALERT_NOTIFICATION_DISPATCH_LIMIT=100

# 自动为运营待办最新认领生成逾期和 7 天内提醒 outbox。
MOCHAT_GO_ENABLE_SAAS_OPERATION_QUEUE_ASSIGNMENT_REMINDER_CRON=0
MOCHAT_GO_SAAS_OPERATION_QUEUE_ASSIGNMENT_REMINDER_CRON_INTERVAL_SECONDS=3600
MOCHAT_GO_SAAS_OPERATION_QUEUE_ASSIGNMENT_REMINDER_CRON_RUN_ON_START=0
MOCHAT_GO_SAAS_OPERATION_QUEUE_ASSIGNMENT_REMINDER_LIMIT=500

# 自动为到达提醒时间的待审批单生成 SLA 提醒 outbox。
MOCHAT_GO_ENABLE_SAAS_APPROVAL_REMINDER_CRON=0
MOCHAT_GO_SAAS_APPROVAL_REMINDER_CRON_INTERVAL_SECONDS=300
MOCHAT_GO_SAAS_APPROVAL_REMINDER_CRON_RUN_ON_START=0
MOCHAT_GO_SAAS_APPROVAL_REMINDER_LIMIT=100

# 周期扫描迁移、后台任务、通知积压、审批 SLA、运营任务与结算同步，并维护系统事故。
MOCHAT_GO_ENABLE_SAAS_SYSTEM_HEALTH_CRON=0
MOCHAT_GO_SAAS_SYSTEM_HEALTH_CRON_INTERVAL_SECONDS=300
MOCHAT_GO_SAAS_SYSTEM_HEALTH_CRON_RUN_ON_START=0
MOCHAT_GO_SAAS_SYSTEM_HEALTH_FAILURE_WINDOW_HOURS=24
MOCHAT_GO_SAAS_SYSTEM_HEALTH_NOTIFICATION_STALE_MINUTES=15

# 数据库灾备默认关闭。密钥和对象存储凭据必须由密钥管理系统注入，不得提交真实值。
MOCHAT_GO_ENABLE_SAAS_BACKUP_CRON=0
MOCHAT_GO_SAAS_BACKUP_CRON_INTERVAL_SECONDS=300
MOCHAT_GO_SAAS_BACKUP_CRON_RUN_ON_START=0
MOCHAT_GO_SAAS_BACKUP_ENCRYPTION_KEY=
# JSON 对象保留当前及历史密钥；当前 ID 必须存在，轮换后不要删除仍有关联备份的旧密钥。
MOCHAT_GO_SAAS_BACKUP_ENCRYPTION_KEYS=
MOCHAT_GO_SAAS_BACKUP_ENCRYPTION_KEY_ID=primary
MOCHAT_GO_SAAS_BACKUP_DUMP_BINARY=mysqldump
MOCHAT_GO_SAAS_BACKUP_RESTORE_BINARY=mysql
# 二选一：固定隔离空库，或由具备 CREATE/DROP DATABASE 权限的管理 DSN 自动创建临时库。
MOCHAT_GO_SAAS_BACKUP_RESTORE_DSN=
MOCHAT_GO_SAAS_BACKUP_RESTORE_ADMIN_DSN=
MOCHAT_GO_SAAS_BACKUP_RESTORE_AUTO_PROVISION=0
MOCHAT_GO_SAAS_BACKUP_RESTORE_KEEP_ON_FAILURE=0
MOCHAT_GO_SAAS_BACKUP_RESTORE_DATABASE_PREFIX=mochat_restore_
# S3、MinIO、Ceph RGW 等兼容对象存储；四项核心配置必须同时提供。
MOCHAT_GO_SAAS_BACKUP_S3_ENDPOINT=
MOCHAT_GO_SAAS_BACKUP_S3_BUCKET=
MOCHAT_GO_SAAS_BACKUP_S3_REGION=
MOCHAT_GO_SAAS_BACKUP_S3_ACCESS_KEY_ID=
MOCHAT_GO_SAAS_BACKUP_S3_SECRET_ACCESS_KEY=
MOCHAT_GO_SAAS_BACKUP_S3_SESSION_TOKEN=
MOCHAT_GO_SAAS_BACKUP_S3_USE_SSL=1
MOCHAT_GO_SAAS_BACKUP_S3_PREFIX=mochat-go/backups

# 审计结构摘要链每小时复核；签名锚点默认每天生成一次。HMAC 密钥不得提交到仓库。
MOCHAT_GO_ENABLE_SAAS_AUDIT_INTEGRITY_CRON=0
MOCHAT_GO_SAAS_AUDIT_INTEGRITY_CRON_INTERVAL_SECONDS=3600
MOCHAT_GO_SAAS_AUDIT_INTEGRITY_CRON_RUN_ON_START=0
MOCHAT_GO_SAAS_AUDIT_INTEGRITY_LIMIT=100
MOCHAT_GO_ENABLE_SAAS_AUDIT_ANCHOR_CRON=0
MOCHAT_GO_SAAS_AUDIT_ANCHOR_CRON_INTERVAL_SECONDS=86400
MOCHAT_GO_SAAS_AUDIT_ANCHOR_CRON_RUN_ON_START=0
MOCHAT_GO_SAAS_AUDIT_ANCHOR_LIMIT=100
MOCHAT_GO_SAAS_AUDIT_ANCHOR_HMAC_KEY=
# JSON 对象保留当前及历史 HMAC 密钥；轮换后必须保留仍被历史锚点引用的旧密钥。
MOCHAT_GO_SAAS_AUDIT_ANCHOR_HMAC_KEYS=
MOCHAT_GO_SAAS_AUDIT_ANCHOR_HMAC_KEY_ID=primary
# 生产建议设为 1，并使用已启用版本控制和 Object Lock 的独立 S3 兼容桶。
MOCHAT_GO_SAAS_AUDIT_ANCHOR_REQUIRE_REMOTE=0
MOCHAT_GO_SAAS_AUDIT_ANCHOR_S3_ENDPOINT=
MOCHAT_GO_SAAS_AUDIT_ANCHOR_S3_BUCKET=
MOCHAT_GO_SAAS_AUDIT_ANCHOR_S3_REGION=
MOCHAT_GO_SAAS_AUDIT_ANCHOR_S3_ACCESS_KEY_ID=
MOCHAT_GO_SAAS_AUDIT_ANCHOR_S3_SECRET_ACCESS_KEY=
MOCHAT_GO_SAAS_AUDIT_ANCHOR_S3_SESSION_TOKEN=
MOCHAT_GO_SAAS_AUDIT_ANCHOR_S3_USE_SSL=1
MOCHAT_GO_SAAS_AUDIT_ANCHOR_S3_PREFIX=mochat-go/audit-anchors
# compliance 模式不能提前删除对象版本；governance 模式允许具备绕过权限的管理员解除留存。
MOCHAT_GO_SAAS_AUDIT_ANCHOR_S3_RETENTION_MODE=compliance
MOCHAT_GO_SAAS_AUDIT_ANCHOR_S3_RETENTION_DAYS=3650

# 租户数据合规导出与擦除队列。默认关闭定时执行，总后台仍可手动操作。
MOCHAT_GO_ENABLE_SAAS_COMPLIANCE_CRON=0
MOCHAT_GO_SAAS_COMPLIANCE_CRON_INTERVAL_SECONDS=300
MOCHAT_GO_SAAS_COMPLIANCE_CRON_RUN_ON_START=0
# 生产环境优先使用独立密钥环；留空时会回退到备份密钥配置。
MOCHAT_GO_SAAS_COMPLIANCE_ENCRYPTION_KEY=
MOCHAT_GO_SAAS_COMPLIANCE_ENCRYPTION_KEYS=
MOCHAT_GO_SAAS_COMPLIANCE_ENCRYPTION_KEY_ID=primary

# 租户自定义域名使用 DNS TXT 校验所有权。留空时使用系统 DNS；内网部署可指定 host:port。
MOCHAT_GO_SAAS_TENANT_DOMAIN_DNS_SERVER=
MOCHAT_GO_SAAS_TENANT_DOMAIN_DNS_TIMEOUT_SECONDS=5

# 将已验证域名交付到外部 Ingress/证书控制面。Bridge token 至少 16 字符，回调密钥至少 32 字符。
MOCHAT_GO_ENABLE_SAAS_TENANT_DOMAIN_DELIVERY_CRON=0
MOCHAT_GO_SAAS_TENANT_DOMAIN_DELIVERY_CRON_INTERVAL_SECONDS=60
MOCHAT_GO_SAAS_TENANT_DOMAIN_DELIVERY_CRON_RUN_ON_START=0
MOCHAT_GO_SAAS_TENANT_DOMAIN_DELIVERY_BRIDGE_BASE_URL=
MOCHAT_GO_SAAS_TENANT_DOMAIN_DELIVERY_BRIDGE_TOKEN=
MOCHAT_GO_SAAS_TENANT_DOMAIN_DELIVERY_BRIDGE_TIMEOUT_SECONDS=10
MOCHAT_GO_SAAS_TENANT_DOMAIN_DELIVERY_CALLBACK_URL=
MOCHAT_GO_SAAS_TENANT_DOMAIN_DELIVERY_CALLBACK_SECRET=
MOCHAT_GO_SAAS_TENANT_DOMAIN_DELIVERY_CALLBACK_TOLERANCE_SECONDS=300
MOCHAT_GO_SAAS_TENANT_DOMAIN_DELIVERY_LIMIT=20
MOCHAT_GO_SAAS_TENANT_DOMAIN_DELIVERY_LEASE_SECONDS=120
MOCHAT_GO_SAAS_TENANT_DOMAIN_DELIVERY_RETRY_DELAY_SECONDS=60
MOCHAT_GO_SAAS_TENANT_DOMAIN_DELIVERY_CALLBACK_WAIT_SECONDS=600

# 自动复查通知健康认领，只关闭已有成功送达证据的健康租户。
MOCHAT_GO_ENABLE_SAAS_NOTIFICATION_HEALTH_RECOVERY_CRON=0
MOCHAT_GO_SAAS_NOTIFICATION_HEALTH_RECOVERY_CRON_INTERVAL_SECONDS=900
MOCHAT_GO_SAAS_NOTIFICATION_HEALTH_RECOVERY_CRON_RUN_ON_START=0
MOCHAT_GO_SAAS_NOTIFICATION_HEALTH_RECOVERY_WINDOW_HOURS=24
MOCHAT_GO_SAAS_NOTIFICATION_HEALTH_RECOVERY_STALE_MINUTES=15

# 自动校准订阅生命周期，把到期、宽限期结束和期末取消落到可审计状态。
MOCHAT_GO_ENABLE_SAAS_SUBSCRIPTION_RECONCILE_CRON=0
MOCHAT_GO_SAAS_SUBSCRIPTION_RECONCILE_CRON_INTERVAL_SECONDS=300
MOCHAT_GO_SAAS_SUBSCRIPTION_RECONCILE_CRON_RUN_ON_START=0
MOCHAT_GO_SAAS_SUBSCRIPTION_RECONCILE_LIMIT=500

# 支付网关回调与失败订单催收；回调密钥至少 32 字符。
MOCHAT_GO_ENABLE_SAAS_PAYMENT_WEBHOOK=0
MOCHAT_GO_SAAS_PAYMENT_WEBHOOK_SECRET=CHANGE_ME_payment_webhook_secret_at_least_32_chars
MOCHAT_GO_SAAS_PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300
MOCHAT_GO_ENABLE_SAAS_PAYMENT_DUNNING_CRON=0
MOCHAT_GO_SAAS_PAYMENT_DUNNING_CRON_INTERVAL_SECONDS=300
MOCHAT_GO_SAAS_PAYMENT_DUNNING_CRON_RUN_ON_START=0
MOCHAT_GO_SAAS_PAYMENT_DUNNING_LIMIT=100
MOCHAT_GO_SAAS_PAYMENT_DUNNING_RETRY_DELAY_SECONDS=86400

# Bootstrap 只创建 SaaS 平台管理员。密码文件只在一次性初始化命令中注入，不属于长运行 app 配置。
MOCHAT_BOOTSTRAP_REQUEST_KEY=initial-saas-admin-v1
MOCHAT_BOOTSTRAP_SAAS_ADMIN_LOGIN=platform-admin
MOCHAT_BOOTSTRAP_SAAS_ADMIN_PHONE=13800000000
MOCHAT_BOOTSTRAP_SAAS_ADMIN_NAME=Platform Admin
